{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/I${workspaceFolder}/include",
                "/I${workspaceFolder}/src/classes",
                "${workspaceFolder}/src/*.cpp",
                "${workspaceFolder}/src/classes/*.cpp",
                "${workspaceFolder}/src/imgui/*.cpp",
                "${workspaceFolder}/src/glad.c",
                "/Fo:${workspaceFolder}/src/build/",
                "/Fd:${workspaceFolder}/src/build/",
                "/link",
                "/LIBPATH:${workspaceFolder}/lib",
                "glfw3dll.lib",
                "freetype.lib",
                "opengl32.lib",
                "user32.lib",
                "gdi32.lib",
                "shell32.lib",
                "/OUT:${workspaceFolder}/src/build/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Main",
            "type": "process",
            "command": "${workspaceFolder}/src/build/main.exe", 
            "args": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
}